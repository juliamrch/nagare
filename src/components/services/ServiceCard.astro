---
interface Props {
  id?: string;
  title: string;
  imageSrc?: string;
  imageAlt?: string;
  price?: string;
  //githubUrl?: string;
  //githubRepos?: { title?: string; url: string }[];
  keyWords?: string[];
}

const {
  id,
  title,
  imageSrc,
  imageAlt = "Project thumbnail",
  price,
  //githubUrl,
  //githubRepos,
  keyWords   = [],
} = Astro.props;

const mailtoHref = `mailto:contact@sobun.io?subject=${encodeURIComponent(
  title
)}`;
---

<article id={id} class="project-card">
  {
    imageSrc && (
      <div class="project-image-wrapper">
        <img
          src={imageSrc}
          alt={imageAlt}
          class="project-image"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="project-content">
    <header class="project-header">
      <h3 class="project-title">{title}</h3>
    </header>

    <div class="project-metadata">
      {price && <span class="project-price">{price}</span>}
      {
        keyWords.length > 0 && (
          <div class="project-keywords">
            {keyWords.map((keyword) => (
              <span class="keyword-tag">{keyword}</span>
            ))}
          </div>
        )
      }
    </div>

    <div class="project-body">
      <slot />
    </div>

    <div class="project-links">
      <a class="contact-button" href={mailtoHref}>
        Contact
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    border-radius: 8px;
    border: 1px solid var(--card-border-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease-out;
    margin-bottom: 3rem;

    opacity: 0;
    filter: blur(5px);
    transform: translateY(20px) translateZ(0);
    will-change: opacity, filter, transform, border-color, backdrop-filter;
    transition:
      opacity 0.8s ease-out,
      filter 0.8s ease-out,
      transform 0.8s ease-out,
      border-color 0.2s ease,
      backdrop-filter 0.2s ease;
  }

  .project-card.visible {
    opacity: 1;
    filter: blur(0px);
    transform: translateY(0) translateZ(0);
  }

  .project-card:hover {
    border-color: var(--card-border-hover-color);
    backdrop-filter: brightness(1.1) saturate(1.1);
  }

  .project-image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-muted);
  }
  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .project-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-header {
    margin-bottom: 1rem;
  }
  .project-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: var(--heading-color);
    line-height: 1.3;
  }

  .project-metadata {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-family: var(--font-family-sans);
  }

  .project-timeframe {
    font-size: 0.9rem;
    color: var(--text-muted);
    display: block;
    font-family: inherit;
  }

  .project-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: inherit;
    line-height: 1.4;
    padding: 0.2em 0 0;
  }
  .project-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background-color: var(--tag-bg-color);
    color: var(--tag-text-color);
    font-size: 0.85rem;
    border-radius: 4px;
    font-family: inherit;
  }
  .keyword-tag {
    background-color: transparent;
    color: #fff;
    font-size: 0.85rem;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    border: 1px solid #fff;
    font-family: inherit;
    line-height: 1.2;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    font-family: inherit;
    margin-top: auto;
    justify-content: center;
  }
  .project-links a {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    transition: color 0.2s ease;
    font-family: inherit;
  }
  .project-links a:hover {
    color: var(--link-hover-color);
    text-decoration: underline;
  }
  .project-links :global(svg) {
    font-size: 1.2em;
  }
  .contact-button {
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--card-border-color);
    color: var(--link-color);
    background: transparent;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }
  .contact-button:hover,
  .contact-button:focus {
    color: var(--link-hover-color);
    border-color: var(--card-border-hover-color);
    text-decoration: none;
  }

  .project-body {
    font-size: 1.1rem;
    line-height: 1.8;
    flex-grow: 1;
  }
  .project-body :global(p) {
    margin-bottom: 1em;
  }
  .project-body :global(ul) {
    padding-left: 1.5em;
    margin-top: 0.5em;
    list-style: disc;
  }
</style>

<script>
  let currentIntersectionObserver: IntersectionObserver | null = null;

  document.addEventListener("astro:page-load", () => {
    if (currentIntersectionObserver) {
      currentIntersectionObserver.disconnect();
    }

    const pageWrapper = document.querySelector(".page-wrapper");
    if (!pageWrapper) {
      console.error("Page wrapper element not found for IntersectionObserver.");
      return;
    }
    const observerOptions = {
      root: pageWrapper,
      rootMargin: "0px",
      threshold: 0.2,
    };

    const observerCallback = (entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    };

    const newObserver = new IntersectionObserver(
      observerCallback,
      observerOptions
    );

    currentIntersectionObserver = newObserver;

    const targets = document.querySelectorAll(".project-card");
    targets.forEach((target) => newObserver.observe(target));
  });
</script>
