---
import Button from "../../common/Button.astro";
import { Icon } from "astro-icon/components";

const contactUrl = "/contact";
---

<h2 slot="title" class="about-title scroll-target-title">Keep in touch</h2>

  <script 
        async src="https://subscribe-forms.beehiiv.com/embed.js">
      </script>
      <iframe
        loading="lazy" 
        src="https://subscribe-forms.beehiiv.com/344d0ef3-4bc6-4411-a71a-769e72282416" 
        class="beehiiv-embed" data-test-id="beehiiv-embed" frameborder="0" scrolling="no" 
        style=
        "width: 660px; 
        height: 415px; 
        margin: 0; 
        border-radius: 0px 0px 0px 0px !important; 
        background-color: transparent; 
        box-shadow: 0 0 #0000; 
        max-width: 100%;
        display: block;
        
        "
        >
      </iframe>

  <div class="connect-icon-links">
    <a
      href="mailto:contact@sobun.io"
      title="Send me an email"
      aria-label="Email"
    >
      <Icon name="ri:mail-line" size={24} aria-hidden="true" />
    </a>
    <a
      href="https://github.com/sobun-io"
      target="_blank"
      rel="noopener noreferrer"
      title="View my GitHub profile"
      aria-label="GitHub"
    >
      <Icon name="ri:github-line" size={22} aria-hidden="true" />
    </a>
    <a
      href="https://www.linkedin.com/in/julia-march"
      target="_blank"
      rel="noopener noreferrer"
      title="View my LinkedIn profile"
      aria-label="LinkedIn"
    >
      <Icon name="ri:linkedin-box-line" size={22} aria-hidden="true" />
    </a>
  </div>

  <!--<div class="button-group">
    <Button
      class="button"
      href={contactUrl}
      text="See All Contact Info"
      wrapperClass="cta-link"
    />
  </div>
</div> -->

<style>
  p {
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--theme-text);
  }

  .connect-icon-links {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    margin-bottom: 2.5rem;
  }

  .connect-icon-links a {
    color: var(--theme-icon-color);
    opacity: 0.8;
    transition:
      opacity 0.2s ease,
      color 0.2s ease;
    display: inline-block;
  }

  .connect-icon-links a:hover,
  .connect-icon-links a:focus {
    opacity: 1;
    outline: none;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
