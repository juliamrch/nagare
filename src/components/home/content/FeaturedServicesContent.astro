---
import {
  allServicesData,
  type ServiceDataItem,
} from "../../../data/serviceData";
import ServiceCard from "../../services/ServiceCard.astro";
import Button from "../../common/Button.astro";


const featuredServices: ServiceDataItem[] = allServicesData.filter(
  (service) => service.isFeatured
);
const servicesUrl = "/services";

function slugify(text: string): string {
  return text
    .toString()
    .toLowerCase()
    .replace(/\s+/g, "-") // Replace spaces with -
    .replace(/[^\w-]+/g, "") // Remove all non-word chars (removed \ before -)
    .replace(/--+/g, "-") // Replace multiple - with single - (removed \ before -)
    .replace(/^-+/, "") // Trim - from start of text
    .replace(/-+$/, ""); // Trim - from end of text
}
---

<h2 slot="title" class="about-title scroll-target-title">Services</h2>

<div class="about-content scroll-target-content featured-works-container">
  {
    featuredServices.map((service) => {
      return (
        <ServiceCard
          title={service.title}
          imageSrc={service.imageSrc}
          imageAlt={service.imageAlt}
          price={service.price}
          projectUrl={service.projectUrl}
          keyWords={service.keyWords}
        >
          <div set:html={service.description} />
        </ServiceCard>
      );
    })
  }

