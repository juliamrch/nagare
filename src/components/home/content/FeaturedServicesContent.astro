<style>
  .featured-works-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 696px) {
    .featured-works-container {
      width: 100%;
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .button-group {
    display: flex;
    gap: 1rem;
  }

  
  .keyword-tag {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  background: var(--tag-bg-color);
  color: var(--tag-text-color);
  font-size: 0.8rem;
  line-height: 1.2;
}


</style>
